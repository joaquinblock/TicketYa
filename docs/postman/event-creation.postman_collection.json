{
  "info": {
    "name": "TicketYa - Creación de eventos",
    "description": "Casos de POST /api/events y de los endpoints del auth-service que usa. Necesita auth-service (8081), event-service (8082) y api-gateway (8080) levantados, y en AuthSeeder la organización 1 con el organizador 2 y la organización 2 sin él (ver docs/team/event-creation-pending.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "authUrl", "value": "http://localhost:8081" },
    { "key": "organizationId", "value": "1" },
    { "key": "otherOrganizationId", "value": "2" },
    { "key": "organizerId", "value": "2" },
    { "key": "venueId", "value": "1" },
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "auth-service",
      "item": [
        {
          "name": "Organización existente",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('No expone CUIT ni cuenta bancaria', () => {",
            "  const body = pm.response.json();",
            "  pm.expect(body).to.not.have.property('taxId');",
            "  pm.expect(body).to.not.have.property('bankAccountNumber');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/organizations/{{organizationId}}" }
        },
        {
          "name": "Organización inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 organization_not_found', () => {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('organization_not_found');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/organizations/999" }
        },
        {
          "name": "Organizador activo",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 con su organización', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().organizationId).to.eql(Number(pm.collectionVariables.get('organizationId')));",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "description": "Directo a auth (authUrl): el gateway todavía no enruta /api/organizers/**.",
            "url": "{{authUrl}}/api/organizers/{{organizerId}}"
          }
        },
        {
          "name": "Usuario que no es organizador → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 organizer_not_found', () => {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('organizer_not_found');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{authUrl}}/api/organizers/1" }
        }
      ]
    },
    {
      "name": "POST /api/events",
      "item": [
        {
          "name": "Evento válido → 201 en DRAFT",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('Nace en DRAFT', () => pm.expect(body.status).to.eql('DRAFT'));",
            "pm.test('Toma la organización y el organizador de los headers', () => {",
            "  pm.expect(body.organizationId).to.eql(Number(pm.collectionVariables.get('organizationId')));",
            "  pm.expect(body.createdBy).to.eql(Number(pm.collectionVariables.get('organizerId')));",
            "});",
            "pm.test('Trae el lugar', () => pm.expect(body.venue.id).to.eql(Number(pm.collectionVariables.get('venueId'))));",
            "pm.collectionVariables.set('eventId', body.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"description\": \"Presentación del nuevo disco\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": true,\n  \"saleStart\": \"2099-11-20T10:00:00\",\n  \"maxTicketsPerCustomer\": 4\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Sin opcionales → 201",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.test('Opcionales en null', () => {",
            "  const body = pm.response.json();",
            "  pm.expect(body.description).to.be.null;",
            "  pm.expect(body.saleStart).to.be.null;",
            "  pm.expect(body.maxTicketsPerCustomer).to.be.null;",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Charla abierta\",\n  \"type\": \"CONFERENCE\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-03-15T18:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Sin X-Organization-Id → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 invalid_parameter', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().error).to.eql('invalid_parameter');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Sin X-User-Id → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 invalid_parameter', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().error).to.eql('invalid_parameter');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Fecha pasada → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 validation_error en dateTime', () => {",
            "  pm.response.to.have.status(400);",
            "  const body = pm.response.json();",
            "  pm.expect(body.error).to.eql('validation_error');",
            "  pm.expect(body.detail).to.have.property('dateTime');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2020-01-01T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Tipo inexistente → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 con los valores permitidos', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().detail.allowedValues).to.be.an('array');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"PICNIC\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Alta demanda sin saleStart → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 invalid_event_configuration', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().error).to.eql('invalid_event_configuration');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": true\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "saleStart posterior al evento → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 invalid_event_configuration', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().error).to.eql('invalid_event_configuration');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false,\n  \"saleStart\": \"2099-12-13T10:00:00\"\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Lugar inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 venue_not_found', () => {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('venue_not_found');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": 999,\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Organización inexistente → 404 (de auth)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 organization_not_found reenviado por el event-service', () => {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('organization_not_found');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "999" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Usuario que no es organizador → 404 (de auth)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 organizer_not_found reenviado por el event-service', () => {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('organizer_not_found');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Organizador de otra organización → 403",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 organizer_not_in_organization', () => {",
            "  pm.response.to.have.status(403);",
            "  pm.expect(pm.response.json().error).to.eql('organizer_not_in_organization');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{otherOrganizationId}}" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        }
      ]
    }
  ]
}
