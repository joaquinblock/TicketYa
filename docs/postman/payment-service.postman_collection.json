{
  "info": {
    "name": "TicketYa - payment-service",
    "description": "Una carpeta por funcionalidad. Necesita payment-service (8084) levantado. Las rutas /internal/** se llaman directo al servicio porque el gateway no las reenvía.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "paymentUrl", "value": "http://localhost:8084" },
    { "key": "orderId", "value": "" },
    { "key": "rejectedOrderId", "value": "" },
    { "key": "retryOrderId", "value": "" },
    { "key": "retryKey", "value": "" },
    { "key": "retryApprovedAnswer", "value": "" },
    { "key": "retryRejectedOrderId", "value": "" },
    { "key": "retryRejectedKey", "value": "" },
    { "key": "retryRejectedAnswer", "value": "" },
    { "key": "pendingOrderId", "value": "3" },
    { "key": "pendingKey", "value": "seed-pending-order-3" }
  ],
  "item": [
    {
      "name": "US-PAY-01: Cobrar una orden",
      "item": [
        {
          "name": "Cobro aprobado → 201",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('orderId', String(Date.now()));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201 aprobado', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('APPROVED');",
              "  pm.expect(body.paymentMethod).to.eql('CREDIT_CARD');",
              "  pm.expect(body.amount).to.eql(25000.00);",
              "  pm.expect(body.gatewayId).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('No expone datos de la tarjeta', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.not.have.any.keys('cardNumber', 'cvv', 'expirationDate');",
              "});"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{orderId}},\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" }
          }
        },
        {
          "name": "Orden con un pago aprobado → 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 data_conflict', () => {",
            "  pm.response.to.have.status(409);",
            "  pm.expect(pm.response.json().error).to.eql('data_conflict');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "description": "Usa la orden que aprobó el request anterior, con otra clave.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{orderId}},\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"ACCOUNT_MONEY\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" }
          }
        },
        {
          "name": "Falta un campo → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 validation_error con el campo', () => {",
            "  pm.response.to.have.status(400);",
            "  const body = pm.response.json();",
            "  pm.expect(body.error).to.eql('validation_error');",
            "  pm.expect(body.detail).to.have.property('idempotencyKey');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1,\n  \"amount\": 100.00,\n  \"paymentMethod\": \"CREDIT_CARD\"\n}" }
          }
        },
        {
          "name": "Medio de pago inexistente → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 validation_error', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().error).to.eql('validation_error');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1,\n  \"amount\": 100.00,\n  \"paymentMethod\": \"CASH\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" }
          }
        },
        {
          "name": "Monto en cero → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 validation_error con el campo', () => {",
            "  pm.response.to.have.status(400);",
            "  const body = pm.response.json();",
            "  pm.expect(body.error).to.eql('validation_error');",
            "  pm.expect(body.detail).to.have.property('amount');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1,\n  \"amount\": 0,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "US-PAY-02: Saber por qué se rechazó un pago",
      "description": "Necesita payment.mock.rejected-method en DEBIT_CARD, el valor por defecto.",
      "item": [
        {
          "name": "Primer rechazo → 422",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('rejectedOrderId', String(Date.now()));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('422 con el motivo y un rechazo', () => {",
              "  pm.response.to.have.status(422);",
              "  const body = pm.response.json();",
              "  pm.expect(body.error).to.eql('payment_rejected');",
              "  pm.expect(body.detail.reason).to.be.a('string').and.not.empty;",
              "  pm.expect(body.detail.rejectedAttempts).to.eql(1);",
              "});"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{rejectedOrderId}},\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"DEBIT_CARD\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" }
          }
        },
        {
          "name": "Segundo rechazo con otra clave → 422",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('422 con dos rechazos', () => {",
            "  pm.response.to.have.status(422);",
            "  pm.expect(pm.response.json().detail.rejectedAttempts).to.eql(2);",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{rejectedOrderId}},\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"DEBIT_CARD\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" }
          }
        },
        {
          "name": "Otro medio después de los rechazos → 201",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 aprobado en la misma orden', () => {",
            "  pm.response.to.have.status(201);",
            "  pm.expect(pm.response.json().status).to.eql('APPROVED');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "description": "Una orden admite otro pago si los anteriores fueron rechazados (US-PAY-01).",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{rejectedOrderId}},\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" }
          }
        }
      ]
    },
    {
