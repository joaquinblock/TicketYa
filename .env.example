# Variables del docker-compose.yml de la raíz. Son opcionales: sin .env se usan estos mismos valores,
# que son los de desarrollo y están en el repo. Para cambiarlos: copiar a .env (ignorado por git).
DB_USER=group10
DB_PASSWORD=group10
DB_ROOT_PASSWORD=group10
# El mismo en todos los servicios: protege /internal/** (US-PAY-14)
INTERNAL_SECRET=dev-internal-secret
