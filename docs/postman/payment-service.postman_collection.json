            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{pendingOrderId}},\n  \"amount\": 70000.00,\n  \"paymentMethod\": \"ACCOUNT_MONEY\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" }
          }
