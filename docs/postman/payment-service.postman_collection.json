            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{retryRejectedOrderId}},\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"DEBIT_CARD\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" }
