      ]
    },
    {
      "name": "Asientos",
      "item": [
        {
          "name": "Listar los asientos de un sector numerado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const seats = pm.response.json();",
                  "pm.collectionVariables.set('seatId', seats[0].id);",
                  "pm.test('20 asientos', () => pm.expect(seats).to.have.lengthOf(20));",
                  "pm.test('Filas A y B', () => pm.expect([...new Set(seats.map(s => s.row))].sort()).to.eql(['A', 'B']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/venues/{{venueId}}/sectors/{{numberedSectorId}}/seats"
          }
        },
        {
          "name": "Agregar una fila",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('5 asientos nuevos en la fila C', () => { const seats = pm.response.json(); pm.expect(seats).to.have.lengthOf(5); seats.forEach(s => pm.expect(s.row).to.eql('C')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/venues/{{venueId}}/sectors/{{numberedSectorId}}/seats",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rows\": [\n    {\n      \"row\": \"C\",\n      \"seats\": 5\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Agregar una fila que ya existe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('seat_row_duplicated', () => pm.expect(pm.response.json().error).to.eql('seat_row_duplicated'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/venues/{{venueId}}/sectors/{{numberedSectorId}}/seats",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rows\": [\n    {\n      \"row\": \"A\",\n      \"seats\": 5\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Agregar asientos a un sector no numerado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('sector_not_numbered', () => pm.expect(pm.response.json().error).to.eql('sector_not_numbered'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/venues/{{venueId}}/sectors/{{generalSectorId}}/seats",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rows\": [\n    {\n      \"row\": \"A\",\n      \"seats\": 5\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Borrar un asiento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/venues/{{venueId}}/sectors/{{numberedSectorId}}/seats/{{seatId}}"
          }
        },
        {
          "name": "El sector queda con 24 asientos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Capacidad 24', () => pm.expect(pm.response.json().capacity).to.eql(24));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/venues/{{venueId}}/sectors/{{numberedSectorId}}"
          }
        }
