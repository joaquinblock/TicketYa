{
  "info": {
    "name": "TicketYa - Creación de eventos",
    "description": "Cada request dice con qué usuario del seeder va en el header X-User-Id: el script de la colección pide su token con dev-login y lo manda como Authorization: Bearer. Necesita el auth-service con el perfil dev (ADR-002) y el api-gateway que valida el token. Casos de POST /api/events y de los endpoints del auth-service que usa, incluido el chequeo de permisos (ver docs/architecture/permissions.md). Necesita auth-service (8081), event-service (8082) y api-gateway (8080) levantados, y en AuthSeeder la organización 1 con el organizador 2 y la organización 2 con el organizador 5, así que el organizador 2 no pertenece a la 2 (ver docs/team/event-creation-pending.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
    "// El api-gateway valida el JWT y borra los X-User-* que mande el cliente (ADR-003). Este script pide el token",
    "// con dev-login (perfil dev, ADR-002) para el usuario del header X-User-Id y lo manda como Authorization.",
    "// No lo guarda: lo pide en cada request, así sigue andando si el auth-service se reinicia con otra clave.",
    "const userHeader = pm.request.headers.get('X-User-Id');",
    "if (userHeader) {",
    "    const userId = pm.variables.replaceIn(userHeader);",
    "    pm.request.headers.remove('X-User-Id');",
    "    pm.sendRequest({",
    "        url: pm.variables.replaceIn('{{baseUrl}}') + '/api/auth/dev-login',",
    "        method: 'POST',",
    "        header: { 'Content-Type': 'application/json' },",
    "        body: { mode: 'raw', raw: JSON.stringify({ userId: Number(userId) }) }",
    "    }, (error, response) => {",
    "        if (error || response.code !== 200) {",
    "            console.warn(`dev-login no dio un token para el usuario ${userId}: el request sale sin identidad`);",
    "            return;",
    "        }",
    "        pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + response.json().accessToken });",
    "    });",
    "}"
  ] } }],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "organizationId", "value": "1" },
    { "key": "otherOrganizationId", "value": "2" },
    { "key": "organizerId", "value": "2" },
    { "key": "clientId", "value": "1" },
    { "key": "venueId", "value": "1" },
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "auth-service",
      "item": [
        {
          "name": "Organización existente",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('No expone CUIT ni cuenta bancaria', () => {",
            "  const body = pm.response.json();",
            "  pm.expect(body).to.not.have.property('taxId');",
            "  pm.expect(body).to.not.have.property('bankAccount');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/organizations/{{organizationId}}" }
        },
        {
          "name": "Organización inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 organization_not_found', () => {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('organization_not_found');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/organizations/999" }
        },
        {
          "name": "Organizador activo",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 con su organización', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().organizationId).to.eql(Number(pm.collectionVariables.get('organizationId')));",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/organizers/{{organizerId}}" }
        },
        {
          "name": "Usuario que no es organizador → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 organizer_not_found', () => {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('organizer_not_found');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/organizers/{{clientId}}" }
        },
        {
          "name": "Permisos del organizador",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 con EVENT_MANAGE', () => {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.role).to.eql('ORGANIZER');",
            "  pm.expect(body.permissions).to.include('EVENT_MANAGE');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{organizerId}}/permissions" }
        },
        {
          "name": "Permisos del cliente: sin EVENT_MANAGE",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 sin EVENT_MANAGE', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().permissions).to.not.include('EVENT_MANAGE');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{clientId}}/permissions" }
        },
        {
          "name": "Permisos de un usuario inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 user_not_found', () => {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('user_not_found');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/999/permissions" }
        }
      ]
    },
    {
      "name": "POST /api/events",
      "item": [
        {
          "name": "Evento válido → 201 en DRAFT",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('Nace en DRAFT', () => pm.expect(body.status).to.eql('DRAFT'));",
            "pm.test('Toma la organización y el organizador del token', () => {",
            "  pm.expect(body.organizationId).to.eql(Number(pm.collectionVariables.get('organizationId')));",
            "  pm.expect(body.createdBy).to.eql(Number(pm.collectionVariables.get('organizerId')));",
            "});",
            "pm.test('Trae el lugar', () => pm.expect(body.venue.id).to.eql(Number(pm.collectionVariables.get('venueId'))));",
            "pm.collectionVariables.set('eventId', body.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"description\": \"Presentación del nuevo disco\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": true,\n  \"saleStart\": \"2099-11-20T10:00:00\",\n  \"maxTicketsPerCustomer\": 4\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Sin opcionales → 201",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.test('Opcionales en null', () => {",
            "  const body = pm.response.json();",
            "  pm.expect(body.description).to.be.null;",
            "  pm.expect(body.saleStart).to.be.null;",
            "  pm.expect(body.maxTicketsPerCustomer).to.be.null;",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Charla abierta\",\n  \"type\": \"CONFERENCE\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-03-15T18:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Sin token → 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 unauthorized', () => {",
            "  pm.response.to.have.status(401);",
            "  pm.expect(pm.response.json().error).to.eql('unauthorized');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Fecha pasada → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 validation_error en dateTime', () => {",
            "  pm.response.to.have.status(400);",
            "  const body = pm.response.json();",
            "  pm.expect(body.error).to.eql('validation_error');",
            "  pm.expect(body.detail).to.have.property('dateTime');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2020-01-01T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Tipo inexistente → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 con los valores permitidos', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().detail.allowedValues).to.be.an('array');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"PICNIC\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Alta demanda sin saleStart → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 invalid_event_configuration', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().error).to.eql('invalid_event_configuration');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": true\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "saleStart posterior al evento → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 invalid_event_configuration', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().error).to.eql('invalid_event_configuration');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false,\n  \"saleStart\": \"2099-12-13T10:00:00\"\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Lugar inexistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 venue_not_found', () => {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('venue_not_found');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": 999,\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Usuario sin EVENT_MANAGE → 403",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 forbidden con el permiso que falta', () => {",
            "  pm.response.to.have.status(403);",
            "  const body = pm.response.json();",
            "  pm.expect(body.error).to.eql('forbidden');",
            "  pm.expect(body.message).to.include('EVENT_MANAGE');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{clientId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Sin permiso y body inválido → 403 (el permiso va primero)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 forbidden, no 400', () => {",
            "  pm.response.to.have.status(403);",
            "  pm.expect(pm.response.json().error).to.eql('forbidden');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{clientId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"  \",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2020-01-01T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Usuario inexistente: dev-login no da token → 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 unauthorized', () => {",
            "  pm.response.to.have.status(401);",
            "  pm.expect(pm.response.json().error).to.eql('unauthorized');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "999" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Mandar otra organización no sirve: se crea en la del token → 201",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.test('El gateway descarta el X-Organization-Id del cliente: queda en la organización del token', () => {",
            "  pm.expect(pm.response.json().organizationId).to.eql(Number(pm.collectionVariables.get('organizationId')));",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{otherOrganizationId}}" },
              { "key": "X-User-Id", "value": "{{organizerId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Serranos en vivo\",\n  \"type\": \"CONCERT\",\n  \"venueId\": {{venueId}},\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"highDemand\": false\n}" },
            "url": "{{baseUrl}}/api/events"
          }
        }
      ]
    }
  ]
}
