            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{retryOrderId}},\n  \"amount\": 25000,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"idempotencyKey\": \"{{retryKey}}\"\n}" }
          }
        },
        {
          "name": "Aprobado: misma clave con otra orden → 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 data_conflict', () => {",
            "  pm.response.to.have.status(409);",
            "  pm.expect(pm.response.json().error).to.eql('data_conflict');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": 999999,\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"idempotencyKey\": \"{{retryKey}}\"\n}" }
          }
        },
        {
          "name": "Aprobado: misma clave con otro monto → 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 data_conflict', () => {",
            "  pm.response.to.have.status(409);",
            "  pm.expect(pm.response.json().error).to.eql('data_conflict');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{retryOrderId}},\n  \"amount\": 25000.01,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"idempotencyKey\": \"{{retryKey}}\"\n}" }
          }
        },
        {
          "name": "Aprobado: misma clave con otro medio → 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 data_conflict', () => {",
            "  pm.response.to.have.status(409);",
            "  pm.expect(pm.response.json().error).to.eql('data_conflict');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{retryOrderId}},\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"ACCOUNT_MONEY\",\n  \"idempotencyKey\": \"{{retryKey}}\"\n}" }
          }
        },
        {
          "name": "Aprobado: repetir después de los conflictos → mismo 201",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Los conflictos no cambiaron el pago', () => {",
            "  pm.response.to.have.status(201);",
            "  pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('retryApprovedAnswer')));",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{retryOrderId}},\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"idempotencyKey\": \"{{retryKey}}\"\n}" }
          }
        },
        {
          "name": "Aprobado: otra clave en la misma orden → 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 data_conflict', () => {",
            "  pm.response.to.have.status(409);",
            "  pm.expect(pm.response.json().error).to.eql('data_conflict');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
