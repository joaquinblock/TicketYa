{
  "info": {
    "name": "TicketYa - Búsqueda de eventos",
    "description": "Cada request dice con qué usuario del seeder va en el header X-User-Id: el script de la colección pide su token con dev-login y lo manda como Authorization: Bearer. Necesita el auth-service con el perfil dev (ADR-002) y el api-gateway que valida el token. GET /api/events (filtros, orden y páginas) y la visibilidad de GET /api/events/{id}. Solo lee: se puede correr las veces que haga falta, con los datos del seeder recién cargados (las fechas son relativas al día de arranque). Ver docs/architecture/event-search.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "organizerId",
      "value": "2"
    },
    {
      "key": "otherOrganizerId",
      "value": "5"
    }
  ],
  "item": [
    {
      "name": "Buscar",
      "item": [
        {
          "name": "Sin filtros: solo PUBLISHED y SOLD_OUT, del más próximo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Primero los eventos [6, 5, 11, 2, 1, 4], después la cartelera (36 en total)', () => { const b = pm.response.json(); pm.expect(b.content.map(e => e.id).slice(0, 6)).to.eql([6, 5, 11, 2, 1, 4]); pm.expect(b.totalElements).to.eql(36); });",
                  "pm.test('Ningún suspendido, cancelado, finalizado ni borrador', () => pm.response.json().content.forEach(e => pm.expect(['PUBLISHED', 'SOLD_OUT']).to.include(e.status)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Por tipo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Primero los conciertos [6, 11, 1], después los 7 de la cartelera', () => { const b = pm.response.json(); pm.expect(b.content.map(e => e.id).slice(0, 3)).to.eql([6, 11, 1]); pm.expect(b.totalElements).to.eql(10); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?type=CONCERT"
          }
        },
        {
          "name": "Por ciudad, sin acentos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Eventos [4, 15, 20, 24, 31, 32, 37, 41]', () => pm.expect(pm.response.json().content.map(e => e.id)).to.eql([4, 15, 20, 24, 31, 32, 37, 41]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?city=cordoba"
          }
        },
        {
          "name": "Por participante (el suspendido no aparece)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Eventos [1, 4]', () => pm.expect(pm.response.json().content.map(e => e.id)).to.eql([1, 4]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?participant=serranos"
          }
        },
        {
          "name": "Por organización",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Eventos [11]', () => pm.expect(pm.response.json().content.map(e => e.id)).to.eql([11]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?organizationId=2"
          }
        },
        {
          "name": "Varios filtros a la vez",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Eventos [11, 17, 18]', () => pm.expect(pm.response.json().content.map(e => e.id)).to.eql([11, 17, 18]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?type=CONCERT&city=tandil"
          }
        },
        {
          "name": "Orden por precio desde",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Primero los eventos [11, 5, 2, 6, 4, 1], después la cartelera, que es más cara', () => pm.expect(pm.response.json().content.map(e => e.id).slice(0, 6)).to.eql([11, 5, 2, 6, 4, 1]));",
                  "pm.test('El primero es el más barato', () => pm.expect(pm.response.json().content[0].priceFrom).to.eql(7000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?sort=PRICE"
          }
        },
        {
          "name": "Relevancia: nombre antes que participante",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Eventos [11, 1, 4]', () => pm.expect(pm.response.json().content.map(e => e.id)).to.eql([11, 1, 4]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?q=serran&sort=RELEVANCE"
          }
        },
        {
          "name": "Páginas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Eventos [1, 4, 13, 14]', () => pm.expect(pm.response.json().content.map(e => e.id)).to.eql([1, 4, 13, 14]));",
                  "pm.test('Cuenta todos', () => { const b = pm.response.json(); pm.expect(b.totalElements).to.eql(36); pm.expect(b.totalPages).to.eql(9); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?page=1&size=4"
          }
        },
        {
          "name": "Comodín % → sin resultados",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Eventos []', () => pm.expect(pm.response.json().content.map(e => e.id)).to.eql([]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?q=%25"
          }
        },
        {
          "name": "from posterior a to → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 invalid_parameter', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.eql('invalid_parameter'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?from=2027-01-10&to=2027-01-01"
          }
        },
        {
          "name": "size 51 → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 validation_error', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().detail).to.have.property('size'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?size=51"
          }
        }
      ]
    },
    {
      "name": "Ver por id",
      "item": [
        {
          "name": "Un cancelado se ve por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 CANCELLED', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('CANCELLED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/8"
          }
        },
        {
          "name": "Borrador sin X-User-Id → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 event_not_found', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error).to.eql('event_not_found'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/3"
          }
        },
        {
          "name": "Borrador para un organizador de su organización → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 DRAFT', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('DRAFT'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/3",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{organizerId}}"
              }
            ]
          }
        },
        {
          "name": "Borrador para un organizador de otra organización → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/3",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{otherOrganizerId}}"
              }
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// El api-gateway valida el JWT y borra los X-User-* que mande el cliente (ADR-003). Este script pide el token",
          "// con dev-login (perfil dev, ADR-002) para el usuario del header X-User-Id y lo manda como Authorization.",
          "// No lo guarda: lo pide en cada request, así sigue andando si el auth-service se reinicia con otra clave.",
          "const userHeader = pm.request.headers.get('X-User-Id');",
          "if (userHeader) {",
          "    const userId = pm.variables.replaceIn(userHeader);",
          "    pm.request.headers.remove('X-User-Id');",
          "    pm.sendRequest({",
          "        url: pm.variables.replaceIn('{{baseUrl}}') + '/api/auth/dev-login',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify({ userId: Number(userId) }) }",
          "    }, (error, response) => {",
          "        if (error || response.code !== 200) {",
          "            console.warn(`dev-login no dio un token para el usuario ${userId}: el request sale sin identidad`);",
          "            return;",
          "        }",
          "        pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + response.json().accessToken });",
          "    });",
          "}"
        ]
      }
    }
  ]
}
