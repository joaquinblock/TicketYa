1;dashPattern=6 4;startArrow=none;endArrow=open;endSize=8;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;opacity=70;" edge="1" parent="1" source="event_sector_price" target="event_sector"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref171" value="seat_id (copy)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;startArrow=none;endArrow=open;endSize=8;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;opacity=70;" edge="1" parent="1" source="event_seat" target="seat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref172" value="user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;startArrow=none;endArrow=open;endSize=8;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;opacity=70;" edge="1" parent="1" source="orders" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref173" value="order_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;startArrow=none;endArrow=open;endSize=8;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;opacity=70;" edge="1" parent="1" source="payment" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref174" value="ticket_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;startArrow=none;endArrow=open;endSize=8;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;opacity=70;" edge="1" parent="1" source="refund" target="ticket"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" value="TicketYa – Data Model (Entrega 1)" style="text;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="leg_fk" value="Solid line: FK inside the same database" style="text;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="720" height="24" as="geometry"/></mxCell><mxCell id="leg_ref" value="Dashed red line / REF: reference by id to another service, no FK (RFC-004). Only the main ones are drawn; every REF column is listed in its table" style="text;fontSize=12;align=left;fontColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1136" width="720" height="40" as="geometry"/></mxCell><mxCell id="note_overlap" value="&lt;b&gt;Overlapping data (copied on purpose)&lt;/b&gt;&lt;br&gt;• event_sale ← event + venue: sell and print the ticket without calling event-service&lt;br&gt;• event_sector_price ← event_sector.price + sector.name&lt;br&gt;• event_sector_stock.capacity ← sector.capacity (non-numbered)&lt;br&gt;• event_seat rows ← seat (numbered): one row per seat, with its own status and version&lt;br&gt;• ticket.price, sector_name, seat_row, number: what the customer paid and what is printed&lt;br&gt;• orders.payment_method ← payment.payment_method" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="800" y="1110" width="820" height="150" as="geometry"/></mxCell><mxCell id="note_rules" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• One database per service; ids of other services are plain columns.&lt;br&gt;• Each user has a single role. Only organizations publish events.&lt;br&gt;• An order belongs to a single event. Ticket limit per user and event.&lt;br&gt;• Logical deletes in auth (deleted_at).&lt;br&gt;&lt;b&gt;Entrega 2 (not yet in the code):&lt;/b&gt; access_assignment, virtual queue (Redis), notifications, preferences (MongoDB)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1660" y="1110" width="920" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
