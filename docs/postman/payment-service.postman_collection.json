            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{pendingOrderId}},\n  \"amount\": 70000.00,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"idempotencyKey\": \"{{pendingKey}}\"\n}" }
          }
        },
        {
          "name": "Pendiente: reintentar otra vez → mismo 201",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Repite el resultado guardado', () => {",
            "  pm.response.to.have.status(201);",
