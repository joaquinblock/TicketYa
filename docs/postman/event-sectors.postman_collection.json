{
  "info": {
    "name": "TicketYa - Sectores y precios del evento",
    "description": "PUT /api/events/{id}/sectors y la publicación que destraba. Necesita auth-service (8081), event-service (8082) y api-gateway (8080) recién levantados, porque cambia los datos del seeder. Es independiente de event-lifecycle: no correr una después de la otra sin reiniciar. El evento 10 es un borrador sin sectores en el Teatro de la Sierra (sectores 3 y 4, 74 asientos).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "organizerId",
      "value": "2"
    },
    {
      "key": "otherOrganizerId",
      "value": "5"
    },
    {
      "key": "draftEventId",
      "value": "10"
    }
  ],
  "item": [
    {
      "name": "Platea y Pullman → 200 con la capacidad",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Capacidad = asientos de los dos sectores', () => pm.expect(body.capacity).to.eql(74));",
              "pm.test('Precios con dos decimales', () => pm.expect(body.sectors.map(s => s.price)).to.have.members([9000, 6500.5]));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/events/{{draftEventId}}/sectors",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{organizerId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sectors\": [\n    {\n      \"sectorId\": 3,\n      \"price\": 9000\n    },\n    {\n      \"sectorId\": 4,\n      \"price\": 6500.5\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Sector repetido → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 invalid_event_configuration', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error).to.eql('invalid_event_configuration');",
              "});",
              "pm.test('Dice cuál', () => pm.expect(pm.response.json().detail.repeatedSectorIds).to.eql([3]));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/events/{{draftEventId}}/sectors",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{organizerId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sectors\": [\n    {\n      \"sectorId\": 3,\n      \"price\": 1000\n    },\n    {\n      \"sectorId\": 3,\n      \"price\": 2000\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Sector de otro lugar → 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('404 sector_not_found', () => {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json().error).to.eql('sector_not_found');",
              "});",
              "pm.test('Dice cuál', () => pm.expect(pm.response.json().detail.missingIds).to.eql([1]));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/events/{{draftEventId}}/sectors",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{organizerId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sectors\": [\n    {\n      \"sectorId\": 1,\n      \"price\": 1000\n    },\n    {\n      \"sectorId\": 3,\n      \"price\": 2000\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Precio 0 → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 validation_error', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error).to.eql('validation_error');",
              "});",
              "pm.test('Marca el campo', () => pm.expect(pm.response.json().detail).to.have.property('sectors[0].price'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/events/{{draftEventId}}/sectors",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{organizerId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sectors\": [\n    {\n      \"sectorId\": 3,\n      \"price\": 0\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Organizador de otra organización → 403",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('403 organizer_not_in_organization', () => {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error).to.eql('organizer_not_in_organization');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/events/{{draftEventId}}/sectors",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{otherOrganizerId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sectors\": [\n    {\n      \"sectorId\": 3,\n      \"price\": 1000\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Evento publicado → 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 event_not_editable', () => {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().error).to.eql('event_not_editable');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/events/1/sectors",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{organizerId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sectors\": [\n    {\n      \"sectorId\": 1,\n      \"price\": 1000\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Con sectores, el borrador se publica → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Queda publicado', () => pm.expect(pm.response.json().status).to.eql('PUBLISHED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/events/{{draftEventId}}/publish",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{organizerId}}"
          }
        ]
      }
    }
  ]
}
