          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{pendingOrderId}},\n  \"amount\": 1.00,\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"idempotencyKey\": \"{{pendingKey}}\"\n}" }
          }
        },
        {
          "name": "Pendiente: otra clave en la misma orden → 409",
