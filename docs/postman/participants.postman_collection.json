{
  "info": {
    "name": "TicketYa - Participantes",
    "description": "ABM de /api/participants y PUT /api/events/{id}/participants. Necesita auth-service (8081), event-service (8082) y api-gateway (8080) levantados con los seeders recién cargados: el evento 10 es un borrador de la organización 1, el 1 está publicado y el participante 1 (Los Serranos) está en eventos. Ver docs/architecture/event-service-api.md, sección Participantes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "organizerId",
      "value": "2"
    },
    {
      "key": "otherOrganizerId",
      "value": "5"
    },
    {
      "key": "clientId",
      "value": "1"
    },
    {
      "key": "draftEventId",
      "value": "10"
    },
    {
      "key": "publishedEventId",
      "value": "1"
    },
    {
      "key": "participantId",
      "value": ""
    },
    {
      "key": "teamId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "ABM de participantes",
      "item": [
        {
          "name": "Listar artistas que contienen 'serr'",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Encuentra a Los Serranos', () => pm.expect(pm.response.json().map(p => p.name)).to.include('Los Serranos'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/participants?type=ARTIST&name=serr"
          }
        },
        {
          "name": "Tipo inexistente → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 invalid_parameter', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.eql('invalid_parameter');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/participants?type=BAND"
          }
        },
        {
          "name": "Crear participante → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('participantId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banda de Prueba\",\n  \"type\": \"ARTIST\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Crear el mismo, con otras mayúsculas → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 participant_duplicated', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error).to.eql('participant_duplicated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"banda de prueba\",\n  \"type\": \"ARTIST\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Mismo nombre con otro tipo → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('teamId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banda de Prueba\",\n  \"type\": \"TEAM\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Sin nombre ni tipo → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 validation_error', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.eql('validation_error');",
                  "});",
                  "pm.test('Indica los dos campos', () => { const d = pm.response.json().detail; pm.expect(d).to.have.property('name'); pm.expect(d).to.have.property('type'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \" \"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Modificar → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Nombre nuevo', () => pm.expect(pm.response.json().name).to.eql('Banda de Prueba 2'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/participants/{{participantId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banda de Prueba 2\",\n  \"type\": \"ARTIST\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Ver inexistente → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 participant_not_found', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error).to.eql('participant_not_found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/participants/999"
          }
        },
        {
          "name": "Borrar uno que está en eventos → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 participant_in_use', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error).to.eql('participant_in_use');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/participants/1"
          }
        },
        {
          "name": "Borrar uno libre → 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/participants/{{participantId}}"
          }
        },
        {
          "name": "Borrar el de tipo TEAM → 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/participants/{{teamId}}"
          }
        }
      ]
    },
    {
      "name": "Participantes de un evento",
      "item": [
        {
          "name": "Asignar a un borrador → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Ordenados por nombre, sin repetidos', () => { const names = pm.response.json().map(p => p.name); pm.expect(names).to.eql([...names].sort((a, b) => a.localeCompare(b))); pm.expect(names.length).to.eql(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/events/{{draftEventId}}/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantIds\": [\n    1,\n    1,\n    5\n  ]\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{organizerId}}"
              }
            ]
          }
        },
        {
          "name": "Participantes inexistentes → 404 con los ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 participant_not_found', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error).to.eql('participant_not_found');",
                  "});",
                  "pm.test('Lista los que faltan', () => pm.expect(pm.response.json().detail.missingIds).to.eql([998, 999]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/events/{{draftEventId}}/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantIds\": [\n    1,\n    998,\n    999\n  ]\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{organizerId}}"
              }
            ]
          }
        },
        {
          "name": "Evento publicado → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 event_not_editable', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error).to.eql('event_not_editable');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/events/{{publishedEventId}}/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantIds\": [\n    1\n  ]\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{organizerId}}"
              }
            ]
          }
        },
        {
          "name": "Organizador de otra organización → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 organizer_not_in_organization', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().error).to.eql('organizer_not_in_organization');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/events/{{draftEventId}}/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantIds\": [\n    1\n  ]\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{otherOrganizerId}}"
              }
            ]
          }
        },
        {
          "name": "Cliente sin EVENT_MANAGE → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 forbidden', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().error).to.eql('forbidden');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/events/{{draftEventId}}/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantIds\": [\n    1\n  ]\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{clientId}}"
              }
            ]
          }
        },
        {
          "name": "Lista vacía → 200 sin participantes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Vacía', () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/events/{{draftEventId}}/participants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantIds\": []\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{organizerId}}"
              }
            ]
          }
        }
      ]
    }
  ]
}
