{
  "info": {
    "name": "TicketYa - Usuarios, organizaciones y organizadores",
    "description": "Consultas del auth-service: permisos de un usuario, organizaciones y organizadores. Son las que usan los otros servicios para autorizar (ver docs/architecture/permissions.md). Necesita auth-service (8081) y api-gateway (8080). Solo lee: se puede repetir. Usuarios del AuthSeeder: 1 cliente, 2 organizador de la organización 1, 3 administrador, 4 personal de acceso, 5 organizador de la organización 2 y 6 organizador de la organización 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Permisos",
      "item": [
        {
          "name": "Permisos del cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Rol CLIENT', () => pm.expect(body.role).to.eql('CLIENT'));",
                  "pm.test('Tiene EVENT_SEARCH', () => pm.expect(body.permissions).to.include('EVENT_SEARCH'));",
                  "pm.test('Tiene TICKET_PURCHASE', () => pm.expect(body.permissions).to.include('TICKET_PURCHASE'));",
                  "pm.test('Tiene REFUND_REQUEST', () => pm.expect(body.permissions).to.include('REFUND_REQUEST'));",
                  "pm.test('No tiene EVENT_MANAGE', () => pm.expect(body.permissions).to.not.include('EVENT_MANAGE'));",
                  "pm.test('No tiene REFUND_RESOLVE', () => pm.expect(body.permissions).to.not.include('REFUND_RESOLVE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/1/permissions"
          }
        },
        {
          "name": "Permisos del organizador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Rol ORGANIZER', () => pm.expect(body.role).to.eql('ORGANIZER'));",
                  "pm.test('Tiene EVENT_MANAGE', () => pm.expect(body.permissions).to.include('EVENT_MANAGE'));",
                  "pm.test('Tiene REPORT_VIEW', () => pm.expect(body.permissions).to.include('REPORT_VIEW'));",
                  "pm.test('No tiene EVENT_ADMIN', () => pm.expect(body.permissions).to.not.include('EVENT_ADMIN'));",
                  "pm.test('No tiene REFUND_RESOLVE', () => pm.expect(body.permissions).to.not.include('REFUND_RESOLVE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/2/permissions"
          }
        },
        {
          "name": "Permisos del administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Rol ADMIN', () => pm.expect(body.role).to.eql('ADMIN'));",
                  "pm.test('Tiene EVENT_ADMIN', () => pm.expect(body.permissions).to.include('EVENT_ADMIN'));",
                  "pm.test('Tiene REFUND_RESOLVE', () => pm.expect(body.permissions).to.include('REFUND_RESOLVE'));",
                  "pm.test('Tiene USER_MANAGE', () => pm.expect(body.permissions).to.include('USER_MANAGE'));",
                  "pm.test('No tiene EVENT_MANAGE', () => pm.expect(body.permissions).to.not.include('EVENT_MANAGE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/3/permissions"
          }
        },
        {
          "name": "Permisos del personal de acceso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Rol ACCESS_STAFF', () => pm.expect(body.role).to.eql('ACCESS_STAFF'));",
                  "pm.test('Tiene TICKET_VALIDATE', () => pm.expect(body.permissions).to.include('TICKET_VALIDATE'));",
                  "pm.test('No tiene EVENT_ADMIN', () => pm.expect(body.permissions).to.not.include('EVENT_ADMIN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/4/permissions"
          }
        },
        {
          "name": "Permisos de un usuario inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('user_not_found', () => pm.expect(pm.response.json().error).to.eql('user_not_found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/999999/permissions"
          }
        }
      ]
    },
    {
      "name": "Organizaciones",
      "item": [
        {
          "name": "Ver una empresa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const org = pm.response.json();",
                  "pm.test('Del Sur Producciones', () => pm.expect(org.publicName).to.eql('Del Sur Producciones'));",
                  "pm.test('Es una empresa', () => pm.expect(org.type).to.eql('COMPANY'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/organizations/1"
          }
        },
        {
          "name": "Ver una asociación civil",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin fines de lucro', () => pm.expect(pm.response.json().type).to.eql('NON_PROFIT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/organizations/2"
          }
        },
        {
          "name": "Ver una organización inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('organization_not_found', () => pm.expect(pm.response.json().error).to.eql('organization_not_found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/organizations/999999"
          }
        }
      ]
    },
    {
      "name": "Organizadores",
      "item": [
        {
          "name": "Ver un organizador de la organización 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Organización 1', () => pm.expect(pm.response.json().organizationId).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/organizers/2"
          }
        },
        {
          "name": "Ver un organizador de la organización 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('Organización 2', () => pm.expect(pm.response.json().organizationId).to.eql(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/organizers/5"
          }
        },
        {
          "name": "Un cliente no es organizador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('organizer_not_found', () => pm.expect(pm.response.json().error).to.eql('organizer_not_found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/organizers/1"
          }
        }
      ]
    }
  ]
}
