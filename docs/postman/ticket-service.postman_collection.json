{
  "info": {
    "name": "TicketYa - Reserva de entradas",
    "description": "Inventario, disponibilidad, reserva y abandono. Lo público (/api/**) entra por el gateway (8080); el inventario (/internal/**) va directo a ticket-service (8083) porque el gateway no expone las rutas internas. Necesita levantados api-gateway y ticket-service. Cada corrida crea su propio evento con ids tomados de la fecha, así que se puede repetir sin reiniciar. El vencimiento de reservas (US-TKT-08) tarda 10 minutos y se prueba en ReservationMySqlIntegrationTest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "internalUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "customerId",
      "value": "501"
    },
    {
      "key": "otherCustomerId",
      "value": "502"
    }
  ],
  "item": [
    {
      "name": "US-TKT-01 Crear el inventario",
      "item": [
        {
          "name": "Publicar la venta → 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const base = Date.now();",
                  "pm.collectionVariables.set('eventId', base);",
                  "pm.collectionVariables.set('numberedSectorId', base + 1);",
                  "pm.collectionVariables.set('generalSectorId', base + 2);",
                  "pm.collectionVariables.set('seatsKey', 'seats-' + base);",
                  "pm.collectionVariables.set('placesKey', 'places-' + base);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{internalUrl}}/internal/event-sales/{{eventId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\",\n  \"eventName\": \"Recital de prueba\",\n  \"venueName\": \"Estadio del Sur\",\n  \"venueAddress\": \"Av. del Estadio 1000\",\n  \"venueCity\": \"Buenos Aires\",\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"saleStart\": null,\n  \"highDemand\": false,\n  \"maxTicketsPerCustomer\": 4,\n  \"sectors\": [\n    {\"eventSectorId\": {{numberedSectorId}}, \"sectorName\": \"Platea\", \"price\": 1000, \"seats\": [\n      {\"seatId\": 1, \"row\": \"A\", \"number\": 1}, {\"seatId\": 2, \"row\": \"A\", \"number\": 2},\n      {\"seatId\": 3, \"row\": \"A\", \"number\": 3}, {\"seatId\": 4, \"row\": \"A\", \"number\": 4},\n      {\"seatId\": 5, \"row\": \"A\", \"number\": 5}, {\"seatId\": 6, \"row\": \"A\", \"number\": 6},\n      {\"seatId\": 7, \"row\": \"A\", \"number\": 7}, {\"seatId\": 8, \"row\": \"A\", \"number\": 8},\n      {\"seatId\": 9, \"row\": \"A\", \"number\": 9}, {\"seatId\": 10, \"row\": \"A\", \"number\": 10}]},\n    {\"eventSectorId\": {{generalSectorId}}, \"sectorName\": \"Campo\", \"price\": 500, \"capacity\": 3}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Repetir la publicación → 204 sin duplicar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{internalUrl}}/internal/event-sales/{{eventId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\",\n  \"eventName\": \"Recital de prueba\",\n  \"venueName\": \"Estadio del Sur\",\n  \"venueAddress\": \"Av. del Estadio 1000\",\n  \"venueCity\": \"Buenos Aires\",\n  \"dateTime\": \"2099-12-12T21:00:00\",\n  \"saleStart\": null,\n  \"highDemand\": false,\n  \"maxTicketsPerCustomer\": 4,\n  \"sectors\": [\n    {\"eventSectorId\": {{numberedSectorId}}, \"sectorName\": \"Platea\", \"price\": 1000, \"seats\": [\n      {\"seatId\": 1, \"row\": \"A\", \"number\": 1}, {\"seatId\": 2, \"row\": \"A\", \"number\": 2},\n      {\"seatId\": 3, \"row\": \"A\", \"number\": 3}, {\"seatId\": 4, \"row\": \"A\", \"number\": 4},\n      {\"seatId\": 5, \"row\": \"A\", \"number\": 5}, {\"seatId\": 6, \"row\": \"A\", \"number\": 6},\n      {\"seatId\": 7, \"row\": \"A\", \"number\": 7}, {\"seatId\": 8, \"row\": \"A\", \"number\": 8},\n      {\"seatId\": 9, \"row\": \"A\", \"number\": 9}, {\"seatId\": 10, \"row\": \"A\", \"number\": 10}]},\n    {\"eventSectorId\": {{generalSectorId}}, \"sectorName\": \"Campo\", \"price\": 500, \"capacity\": 3}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "US-TKT-02 Consultar la disponibilidad",
      "item": [
        {
          "name": "Evento publicado → 200 por sector",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const sectors = pm.response.json().sectors;",
                  "pm.test('10 asientos libres', () => pm.expect(sectors[0].availablePlaces).to.eql(10));",
                  "pm.test('3 lugares libres', () => pm.expect(sectors[1].availablePlaces).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/availability?eventId={{eventId}}",
            "header": []
          }
        },
        {
          "name": "Evento sin venta → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('error = resource_not_found', () => pm.expect(pm.response.json().error).to.eql('resource_not_found'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": []
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/availability?eventId=999999999",
            "header": []
          }
        }
      ]
    },
