  "item": [
    {
      "name": "Login de desarrollo",
      "description": "Solo con el perfil dev (la run config de IntelliJ ya lo activa). Emite el JWT de TicketYa de un usuario del seeder sin pasar por Google. El primer request guarda el token en {{token}}. Ver docs/adr/ADR-002-dev-login.md.",
      "item": [
        {
          "name": "Token del cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Tipo Bearer', () => pm.expect(body.tokenType).to.eql('Bearer'));",
                  "pm.test('Vence en 30 min', () => pm.expect(body.expiresIn).to.eql(1800));",
                  "const decode = part => JSON.parse(atob(part.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - part.length % 4) % 4)));",
                  "const [header, claims] = body.accessToken.split('.').slice(0, 2).map(decode);",
                  "pm.test('Firmado con RS256', () => pm.expect(header.alg).to.eql('RS256'));",
                  "pm.test('iss = ticketya-auth', () => pm.expect(claims.iss).to.eql('ticketya-auth'));",
                  "pm.test('aud = ticketya-api', () => pm.expect([].concat(claims.aud)).to.include('ticketya-api'));",
                  "pm.test('exp 30 min después de iat', () => pm.expect(claims.exp - claims.iat).to.eql(1800));",
                  "pm.test('Tiene jti', () => pm.expect(claims.jti).to.be.a('string').and.not.empty);",
                  "pm.test('sub = 1', () => pm.expect(claims.sub).to.eql('1'));",
                  "pm.test('Rol CLIENT', () => pm.expect(claims.role).to.eql('CLIENT'));",
                  "pm.test('Permisos de comprador', () => pm.expect(claims.permissions).to.include.members(['EVENT_SEARCH', 'TICKET_PURCHASE', 'REFUND_REQUEST']));",
                  "pm.test('Sin organizationId', () => pm.expect(claims).to.not.have.property('organizationId'));",
                  "pm.collectionVariables.set('token', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\": 1}"
            },
            "url": "{{baseUrl}}/api/auth/dev-login"
          }
        },
