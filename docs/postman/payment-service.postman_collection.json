          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{paymentUrl}}/internal/payments",
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": {{retryRejectedOrderId}},\n  \"amount\": 25000.00,\n  \"paymentMethod\": \"DEBIT_CARD\",\n  \"idempotencyKey\": \"{{retryRejectedKey}}\"\n}" }
          }
        },
        {
          "name": "Pendiente: misma clave con otros datos → 409",
